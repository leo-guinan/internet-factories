{
  "name": "internet-factories",
  "private": true,
  "version": "0.1.0",
  "description": "A runtime for scheduling, measuring, evaluating, and comparing production factories.",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -b --pretty false",
    "validate": "pnpm typecheck && pnpm test",
    "smoke": "tsx apps/smoke/src/index.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
